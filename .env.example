# GEMINI_API_KEY: Required for Gemini AI chatbot.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── Google Sheets Inventory Integration ───────────────────────────────────
# GOOGLE_SHEET_ID: The ID from the Google Sheet URL.
# Example URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID="MY_GOOGLE_SHEET_ID"

# GOOGLE_CLIENT_EMAIL: The service account email from your Google Cloud JSON key file.
# Example: my-service-account@my-project.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL="MY_SERVICE_ACCOUNT_EMAIL"

# GOOGLE_PRIVATE_KEY: The private_key value from the JSON key file.
# IMPORTANT: In Vercel, paste the full key including -----BEGIN/END----- lines.
# Vercel will escape the newlines automatically. The api/inventory.ts handler
# applies .replace(/\\n/g, '\n') to restore them before passing to googleapis.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMY_PRIVATE_KEY_CONTENT\n-----END RSA PRIVATE KEY-----"
